# Copy this to `fastlane/.env` (which is gitignored) and fill in your values.
# fastlane automatically loads fastlane/.env for every lane, so you won't need to
# `export` these in each terminal session.
#
#   cp fastlane/.env.example fastlane/.env
#   # then edit fastlane/.env with your real values
#
# Create the key at App Store Connect → Users and Access → Integrations →
# App Store Connect API. The .p8 itself stays on disk (path below) and is gitignored.

ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
