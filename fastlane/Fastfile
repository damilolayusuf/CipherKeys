default_platform(:ios)

# CipherKeys — App Store Connect automation.
#
# Auth uses an App Store Connect API key (no 2FA prompts). Create one at
# App Store Connect → Users and Access → Integrations → App Store Connect API,
# download the .p8, and set these env vars (NEVER commit the .p8):
#
#   export ASC_KEY_ID=XXXXXXXXXX
#   export ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#   export ASC_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
#
# Then push text metadata only:   fastlane metadata
# (Screenshots + binary stay out of scope here; add them later.)

platform :ios do
  def asc_api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
  end

  desc "Push App Store text metadata only (no binary, no screenshots)"
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      app_identifier: "com.xkabiir.cipherkeys",
      skip_binary_upload: true,
      skip_screenshots: true,
      run_precheck_before_submit: false,
      submit_for_review: false,
      force: true # skip the HTML preview confirmation
    )
  end

  desc "Capture App Store screenshots in the simulator (no upload)"
  lane :screenshots do
    capture_ios_screenshots(
      scheme: "CipherKeys",
      devices: [
        "iPhone 16 Pro Max",     # 6.9" iPhone
        "iPad Pro 13-inch (M4)"  # 13" iPad (drop if you make the app iPhone-only)
      ],
      languages: ["en-CA"],
      output_directory: "./fastlane/screenshots",
      clear_previous_screenshots: true,
      override_status_bar: true, # clean 9:41 / full battery status bar
      concurrent_simulators: true,
      stop_after_first_error: true
    )
  end

  desc "Capture screenshots and upload them to App Store Connect"
  lane :screenshots_upload do
    screenshots
    deliver(
      api_key: asc_api_key,
      app_identifier: "com.xkabiir.cipherkeys",
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      submit_for_review: false,
      force: true
    )
  end
end
